{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-pocket",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resume-pocket-auth",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "resume-pocket-files" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2800127", "simple": { "limit": 15, "period": 60 } }
  ]
}
