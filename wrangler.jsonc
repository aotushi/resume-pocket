{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-pocket",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "ADMIN_EMAILS", "SHARE_TOKEN_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resume-pocket-auth",
      "database_id": "6c90b051-f694-4c20-a048-fe41b577def8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "resume-pocket-files" }],
  // Word 转 PDF：LibreOffice 容器，需 Workers Paid
  // 本地 dev 不启动容器（Windows 不支持）：手动 docker run 转换镜像，并在 .dev.vars 设置 WORD_CONVERTER_URL
  "dev": { "enable_containers": false },
  "vars": { "WORD_CONVERTER_URL": "", "EMAIL_FROM": "no-reply@jianli.9shi.cc" },
  // 验证码邮件：Cloudflare Email Service，发件域名需先开通 Email Sending，再把 EMAIL_FROM 设为该域名下的地址
  "send_email": [{ "name": "EMAIL" }],
  // 镜像由 Workers Builds 在海外构建，直接用 deb.debian.org；本机手动构建需要国内源时用 --build-arg APT_MIRROR（见 README）
  "containers": [{ "class_name": "WordConverter", "image": "./converter/Dockerfile", "instance_type": "basic", "max_instances": 3 }],
  "durable_objects": { "bindings": [{ "name": "WORD_CONVERTER", "class_name": "WordConverter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WordConverter"] }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2800127", "simple": { "limit": 15, "period": 60 } },
    // 游客上传与管理链接恢复：每个 IP 每分钟 5 次
    { "name": "GUEST_LIMITER", "namespace_id": "2800128", "simple": { "limit": 5, "period": 60 } },
    // 验证码发送：每个邮箱每分钟 3 次，防止对同一邮箱刷信
    { "name": "OTP_LIMITER", "namespace_id": "2800129", "simple": { "limit": 3, "period": 60 } }
  ]
}
